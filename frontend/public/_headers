# Cabeçalhos de segurança aplicados pelo Cloudflare Pages.
# O Pages já envia X-Content-Type-Options e Referrer-Policy; o resto vem daqui.

/*
  # Impede que o site seja embutido em iframe de terceiros (clickjacking).
  X-Frame-Options: DENY

  # Um ano de HTTPS obrigatório. O site já é HTTPS-only e o www redireciona,
  # então não há caminho HTTP legítimo para quebrar.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Recursos de hardware que o portfolio não usa.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # CSP restritiva ao que o site realmente carrega: scripts e estilos próprios,
  # fontes auto-hospedadas, imagens locais, e a API de contato no Cloud Run.
  # 'unsafe-inline' em script-src é necessário pelo script de tema e pelos
  # dados de hidratação do Next; em style-src, pelas custom properties inline
  # que posicionam o brilho que segue o cursor.
  # O Cloudflare Web Analytics injeta o beacon de static.cloudflareinsights.com
  # e envia as medições para cloudflareinsights.com. Sem essas duas entradas, a
  # CSP derrubaria a análise de visitas do site.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://backend-portfolio-647040491292.southamerica-east1.run.app https://cloudflareinsights.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
